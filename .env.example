# ==============================================================================
# Smart AI Legal Automation Platform - Environment Configuration Template
# Copy this file to .env and customize as needed:
# cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Free tier from https://aistudio.google.com)
# Leave blank to use built-in legal heuristics & offline knowledge base
GEMINI_API_KEY=

# Gemini Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Database Connection String
# Leave blank to use high-concurrency SQLite in WAL mode locally
# For production PostgreSQL (e.g. Neon.tech or Supabase free tier):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-sample-123.neon.tech/neondb?sslmode=require
DATABASE_URL=

# SQLite Data Directory (Useful for Docker Volume Persistence)
# DB_DIR=/app/backend/data
DB_DIR=

# Server Host & Port
HOST=127.0.0.1
PORT=8000
